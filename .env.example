# ==============================================================================
# MAILRADAR – REAL-TIME EMAIL SECURITY & INTELLIGENCE ANALYZER
# Environment Configuration Template
# ==============================================================================

# Flask Server Port & Settings
PORT=5000
FLASK_DEBUG=False
SECRET_KEY=replace-with-a-secure-random-secret-key

# ==============================================================================
# Google Public DNS JSON API (Used for MX, SPF, DMARC, and A record verification)
# Default: https://dns.google/resolve (No API key required)
# ==============================================================================

# ==============================================================================
# Abstract Email Reputation API
# Endpoint: https://emailreputation.abstractapi.com/v1/
# Used for real-time reputation analysis, deliverability, quality scoring,
# domain longevity, sender details, risk status, and breach intelligence.
# ==============================================================================
ABSTRACT_API_KEY=your_abstract_api_key_here

# ==============================================================================
# Behind the Email API (Public profiles, social accounts, work history, breaches)
# Base URL: https://api.behindtheemail.com/v1
# Token format: BTE_...
# ==============================================================================
BEHIND_THE_EMAIL_API_KEY=your_behindtheemail_token_here

# ==============================================================================
# IntelBase API (Optional real-time OSINT, breaches, stealer logs, registered accounts)
# Get your API key at: https://intelbase.is/dashboard (Paid plan required)
# Whitelist your IP at: https://intelbase.is/dashboard (Check with /api/intelbase/ip)
# ==============================================================================
INTELBASE_API_KEY=your_intelbase_api_key_here

# ==============================================================================
# Have I Been Pwned (HIBP) API v3
# Official Documentation: https://haveibeenpwned.com/API/v3
# API Key: 32-character hexadecimal string from https://haveibeenpwned.com/API/Key
# (For automated tests on @hibp-integration-tests.com, test key 00000000000000000000000000000000 is used automatically)
# ==============================================================================
HIBP_API_KEY=your_hibp_api_key_here

# ==============================================================================
# EmailRep API (Optional)
# Get an authorized API key at: https://emailrep.io/key
# ==============================================================================
EMAILREP_API_KEY=your_emailrep_api_key_here
